@model VASReportingTool.Models.DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Hourly Comparison";
    var defaultRegionId = Model.DefaultRegionId;
}

<style>
    .hc-cumul-row td { font-weight: 700; background: #eff6ff; border-top: 2px solid #bfdbfe !important; }
    .hc-toggle { background:none; border:none; cursor:pointer; padding:0 4px; font-size:11px; color:#2563eb; vertical-align:middle; line-height:1; }
    .hc-toggle:hover { color:#1d4ed8; }
    .hc-tab {
        padding: 10px 22px;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
        cursor: pointer;
        font-family: inherit;
        transition: color .15s, border-color .15s;
    }
    .hc-tab:hover { color: #111827; }
    .hc-tab.active { color: #2563eb; border-bottom-color: #2563eb; }
    .hc-badge {
        display: inline-block;
        padding: 2px 9px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }
    .hc-ok   { background: #dcfce7; color: #15803d; }
    .hc-warn { background: #fef3c7; color: #92400e; }
    .hc-crit { background: #fee2e2; color: #b91c1c; }
    .hc-neut { background: #f3f4f6; color: #6b7280; }
    .hc-today { font-weight: 700; color: #111827; }
    .hc-comp  { color: #6b7280; }
    .hc-remark { font-size: 11px; color: #6b7280; white-space: nowrap; }
    .hc-good-pill { background: #dcfce7; color: #15803d; padding: 1px 8px; border-radius: 10px; font-size: 11px; font-weight: 700; }
    .hc-bad-pill  { background: #fee2e2; color: #b91c1c; padding: 1px 8px; border-radius: 10px; font-size: 11px; font-weight: 700; }
    @@keyframes hc-spin { to { transform: rotate(360deg); } }
</style>

<div class="container" style="padding-top:24px;padding-bottom:40px;">

    <div class="page-actions" style="margin-bottom:18px;">
        <div>
            <h1 class="section-title" style="margin-bottom:2px;">Hourly Comparison</h1>
            <div id="hc-dateband" style="font-size:12px;color:#6b7280;font-family:'IBM Plex Mono',monospace;">
                Today vs Yesterday vs 7-Day Average
            </div>
        </div>
        <div class="btn-row">
            <a class="ghost-btn" href="@Url.Action("Index","ToolSummary")">MissingReports</a>
            <a class="ghost-btn" href="@Url.Action("Index","Dashboard")">Reports</a>
        </div>
    </div>

    <div class="card" style="padding:20px 24px;margin-bottom:0;border-radius:12px 12px 0 0;border-bottom:1px solid #e5e7eb;">
        <div style="margin-bottom:16px;">
            <div style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">Region</div>
            <div id="hc-region-chips" style="display:flex;flex-wrap:wrap;gap:8px;">
                @foreach (var r in Model.Regions)
                {
                    <button type="button"
                            class="region-chip @(r.RegionId == defaultRegionId ? "active" : string.Empty)"
                            data-region-id="@r.RegionId">@r.Name</button>
                }
            </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;">
            <div>
                <label style="display:block;font-size:11px;font-weight:600;color:#6b7280;margin-bottom:4px;">Country</label>
                <select id="hc-country" class="filter-select" style="min-width:150px;" disabled>
                    <option value="">All countries</option>
                </select>
            </div>
            <div>
                <label style="display:block;font-size:11px;font-weight:600;color:#6b7280;margin-bottom:4px;">Operator</label>
                <select id="hc-operator" class="filter-select" style="min-width:150px;" disabled>
                    <option value="">All operators</option>
                </select>
            </div>
            <div>
                <label style="display:block;font-size:11px;font-weight:600;color:#6b7280;margin-bottom:4px;">Service</label>
                <select id="hc-service" class="filter-select" style="min-width:150px;" disabled>
                    <option value="">All services</option>
                </select>
            </div>
            <button id="hc-load" class="primary-btn" disabled style="height:36px;">Load Comparison</button>
        </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #e5e7eb;background:#fff;border-radius:0;padding:0 8px;">
        <div style="display:flex;gap:0;">
            <button class="hc-tab active" data-tab="revenue">Revenue</button>
            <button class="hc-tab" data-tab="activation">Activation</button>
            <button class="hc-tab" data-tab="churn">Churn</button>
            <button class="hc-tab" data-tab="retry">Retry Bucket</button>
        </div>
        <input id="hc-search" type="text" placeholder="Search (comma-separated: Country,Operator,Service)"
               style="padding:5px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:12px;width:280px;outline:none;" />
    </div>

    <div class="report-table-card card" style="border-radius:0 0 12px 12px;border-top:none;min-height:200px;">
        <div id="hc-loading" style="display:none;padding:56px;text-align:center;">
            <div style="display:inline-block;width:40px;height:40px;border:4px solid #e5e7eb;border-top-color:#2563eb;border-radius:50%;animation:hc-spin .8s linear infinite;"></div>
            <div style="margin-top:14px;color:#6b7280;font-size:13px;">Fetching hourly data (today / yesterday / 7-day average)...</div>
        </div>
        <div id="hc-error" style="display:none;padding:32px;text-align:center;color:#dc2626;font-size:14px;"></div>
        <div id="hc-prompt" style="padding:48px;text-align:center;color:#9ca3af;font-size:14px;">
            Select a region above, then click <strong>Load Comparison</strong>.
        </div>
        <div id="hc-empty" style="display:none;padding:48px;text-align:center;color:#9ca3af;font-size:14px;">No hourly data found for the selected filters.</div>
        <div id="hc-wrap" style="display:none;overflow-x:auto;max-height:680px;overflow-y:auto;">
            <table class="report-table" id="hc-table">
                <thead id="hc-thead"></thead>
                <tbody id="hc-tbody"></tbody>
            </table>
        </div>
        <div id="hc-foot" style="display:none;padding:8px 16px 10px;font-size:12px;color:#9ca3af;justify-content:space-between;flex-wrap:wrap;gap:4px;">
            <span id="hc-legend">
                <span class="hc-badge hc-ok">OK</span> <= 5% drop
                <span class="hc-badge hc-warn" style="margin-left:8px;">WARN</span> 5% to 20% drop
                <span class="hc-badge hc-crit" style="margin-left:8px;">LOW</span> > 20% drop
            </span>
            <span id="hc-count"></span>
        </div>
    </div>

</div>

<script>
(function () {
    var selectedRegionId = null;
    var allData = [];
    var activeTab = 'revenue';

    var countriesUrl = '@Url.Content("~/api/regions/countries")';
    var operatorsUrl = '@Url.Content("~/api/regions/operators")';
    var servicesUrl = '@Url.Content("~/api/regions/services")';
    var hourlyDataUrl = '@Url.Action("HourlyData", "ToolSummary")';

    document.querySelectorAll('.hc-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.hc-tab').forEach(function (b) { b.classList.remove('active'); });
            this.classList.add('active');
            activeTab = this.dataset.tab;
            if (allData.length) {
                renderTable();
            }
        });
    });

    document.getElementById('hc-search').addEventListener('input', function () {
        if (allData.length) { renderTable(); }
    });

    document.getElementById('hc-region-chips').addEventListener('click', function (e) {
        var chip = e.target.closest('.region-chip');
        if (!chip) {
            return;
        }

        document.querySelectorAll('#hc-region-chips .region-chip').forEach(function (c) { c.classList.remove('active'); });
        chip.classList.add('active');
        selectedRegionId = chip.dataset.regionId;
        var regionName = chip.textContent.trim();
        var retryTab = document.querySelector('.hc-tab[data-tab="retry"]');
        if (regionName === 'APAC' || regionName === 'MENA') {
            retryTab.style.display = 'none';
            if (activeTab === 'retry') {
                activeTab = 'revenue';
                document.querySelectorAll('.hc-tab').forEach(function (b) { b.classList.remove('active'); });
                document.querySelector('.hc-tab[data-tab="revenue"]').classList.add('active');
            }
        } else {
            retryTab.style.display = '';
        }
        document.getElementById('hc-prompt').innerHTML = 'Region selected: <strong>' + esc(regionName) + '</strong>. Click <strong>Load Comparison</strong>.';
        setState('prompt');
        resetSel('hc-country', 'Loading...');
        resetSel('hc-operator', 'All operators');
        resetSel('hc-service', 'All services');
        loadCountries();
    });

    document.getElementById('hc-country').addEventListener('change', function () {
        resetSel('hc-operator', 'All operators');
        resetSel('hc-service', 'All services');

        var country = this.value;
        if (!country || !selectedRegionId) {
            return;
        }

        var sel = document.getElementById('hc-operator');
        sel.innerHTML = '<option value="">Loading...</option>';
        sel.disabled = true;
        fetch(operatorsUrl + '?regionId=' + selectedRegionId + '&country=' + encodeURIComponent(country))
            .then(function (r) { return r.json(); })
            .then(function (data) { populateSel('hc-operator', Array.isArray(data) ? data : [], 'All operators'); })
            .catch(function () { populateSel('hc-operator', [], 'All operators'); });
    });

    document.getElementById('hc-operator').addEventListener('change', function () {
        resetSel('hc-service', 'All services');

        var country = document.getElementById('hc-country').value;
        var operator = this.value;
        if (!operator || !selectedRegionId) {
            return;
        }

        var sel = document.getElementById('hc-service');
        sel.innerHTML = '<option value="">Loading...</option>';
        sel.disabled = true;
        fetch(servicesUrl + '?regionId=' + selectedRegionId + '&country=' + encodeURIComponent(country) + '&operatorName=' + encodeURIComponent(operator))
            .then(function (r) { return r.json(); })
            .then(function (data) { populateSel('hc-service', Array.isArray(data) ? data : [], 'All services'); })
            .catch(function () { populateSel('hc-service', [], 'All services'); });
    });

    document.getElementById('hc-load').addEventListener('click', function () {
        if (!selectedRegionId) {
            return;
        }

        document.getElementById('hc-search').value = '';
        var country = document.getElementById('hc-country').value;
        var operator = document.getElementById('hc-operator').value;
        var service = document.getElementById('hc-service').value;

        setState('loading');

        var url = hourlyDataUrl + '?regionId=' + selectedRegionId;
        if (country) {
            url += '&country=' + encodeURIComponent(country);
        }
        if (operator) {
            url += '&operatorName=' + encodeURIComponent(operator);
        }
        if (service) {
            url += '&serviceName=' + encodeURIComponent(service);
        }

        fetch(url)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.error) {
                    setState('error', data.error);
                    return;
                }

                allData = data.Rows || [];

                if (data.Date) {
                    var datebandParts = [
                        'Today: ' + data.Date,
                        'Yesterday: ' + data.Yesterday,
                        '7-Day avg from: ' + data.Days7From,
                        'Latest hour: country specific'
                    ];
                    document.getElementById('hc-dateband').textContent = datebandParts.join(' | ');
                }

                renderTable();
            })
            .catch(function () {
                setState('error', 'Failed to load data. Please try again.');
            });
    });

    var TABS = {
        revenue: {
            heads: ['Country', 'Operator', 'Service', 'Hour', "Today's Revenue / Count", "Yesterday's Revenue / Count", '7-Day Avg Revenue / Count', 'Status', 'Remark'],
            cells: function (r) {
                var si  = statusInfo(r.TodayRev, r.YestRev, false);
                var sep = '<span style="color:#9ca3af;margin:0 5px;">|</span>';
                return [
                    td(esc(r.Country)),
                    td(esc(r.Operator)),
                    td(esc(r.Service)),
                    tdC(hourLabel(r.Hour)),
                    tdR('<span class="hc-today">' + fmt(r.TodayRev) + '</span>' + sep + '<span class="hc-comp">' + fmt(r.TodayRenewal) + '</span>'),
                    tdR('<span class="hc-comp">'  + fmt(r.YestRev)  + '</span>' + sep + '<span class="hc-comp">' + fmt(r.YestRenewal)  + '</span>'),
                    tdR('<span class="hc-comp">'  + fmt(r.Avg7Rev)  + '</span>' + sep + '<span class="hc-comp">' + fmt(r.Avg7Renewal)  + '</span>'),
                    tdC(badge(si.status)),
                    td('<span class="hc-remark">' + esc(si.remark) + '</span>')
                ].join('');
            }
        },
        activation: {
            heads: ['Country', 'Operator', 'Service', 'Hour', "Today's Activation", "Yesterday's Activation", '7-Day Avg Activation', 'Status', 'Remark'],
            cells: function (r) {
                var si = statusInfo(r.TodayActiv, r.YestActiv, false);
                return [
                    td(esc(r.Country)),
                    td(esc(r.Operator)),
                    td(esc(r.Service)),
                    tdC(hourLabel(r.Hour)),
                    tdR('<span class="hc-today">' + fmt(r.TodayActiv) + '</span>'),
                    tdR('<span class="hc-comp">' + fmt(r.YestActiv) + '</span>'),
                    tdR('<span class="hc-comp">' + fmt(r.Avg7Activ) + '</span>'),
                    tdC(badge(si.status)),
                    td('<span class="hc-remark">' + esc(si.remark) + '</span>')
                ].join('');
            }
        },
        churn: {
            heads: ['Country', 'Operator', 'Service', 'Hour', "Today's Churn", "Yesterday's Churn", '7-Day Avg Churn', 'Status', 'Remark'],
            cells: function (r) {
                var si = statusInfo(r.TodayChurn, r.YestChurn, true);
                return [
                    td(esc(r.Country)),
                    td(esc(r.Operator)),
                    td(esc(r.Service)),
                    tdC(hourLabel(r.Hour)),
                    tdR('<span class="hc-today">' + fmt(r.TodayChurn) + '</span>'),
                    tdR('<span class="hc-comp">' + fmt(r.YestChurn) + '</span>'),
                    tdR('<span class="hc-comp">' + fmt(r.Avg7Churn) + '</span>'),
                    tdC(badge(si.status)),
                    td('<span class="hc-remark">' + esc(si.remark) + '</span>')
                ].join('');
            }
        },
        retry: {
            heads: ['Country', 'Operator', 'Service', 'Hour', 'Type', "Today's Count", "Yesterday's Count", '7-Day Avg Count', 'Status', 'Remark'],
            cells: function (r) {
                var sgood = statusInfo(r.TodayGood, r.YestGood, false);
                var sbad = statusInfo(r.TodayBad, r.YestBad, true);
                var common = td(esc(r.Country)) + td(esc(r.Operator)) + td(esc(r.Service)) + tdC(hourLabel(r.Hour));
                return [
                    common
                        + tdC('<span class="hc-good-pill">Good Base</span>')
                        + tdR('<span class="hc-today">' + fmt(r.TodayGood) + '</span>')
                        + tdR('<span class="hc-comp">' + fmt(r.YestGood) + '</span>')
                        + tdR('<span class="hc-comp">' + fmt(r.Avg7Good) + '</span>')
                        + tdC(badge(sgood.status))
                        + td('<span class="hc-remark">' + esc(sgood.remark) + '</span>'),
                    common
                        + tdC('<span class="hc-bad-pill">Bad Base</span>')
                        + tdR('<span class="hc-today">' + fmt(r.TodayBad) + '</span>')
                        + tdR('<span class="hc-comp">' + fmt(r.YestBad) + '</span>')
                        + tdR('<span class="hc-comp">' + fmt(r.Avg7Bad) + '</span>')
                        + tdC(badge(sbad.status))
                        + td('<span class="hc-remark">' + esc(sbad.remark) + '</span>')
                ];
            }
        }
    };

    function loadCountries() {
        var sel = document.getElementById('hc-country');
        sel.innerHTML = '<option value="">Loading...</option>';
        sel.disabled = true;
        document.getElementById('hc-load').disabled = true;

        fetch(countriesUrl + '?regionId=' + selectedRegionId)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                populateSel('hc-country', Array.isArray(data) ? data : [], 'All countries');
                document.getElementById('hc-load').disabled = false;
            })
            .catch(function () {
                populateSel('hc-country', [], 'All countries');
                document.getElementById('hc-load').disabled = false;
            });
    }

    function resetSel(id, placeholder) {
        var el = document.getElementById(id);
        el.innerHTML = '<option value="">' + placeholder + '</option>';
        el.disabled = true;
    }

    function populateSel(id, items, placeholder) {
        var sel = document.getElementById(id);
        sel.innerHTML = '<option value="">' + placeholder + '</option>';
        items.forEach(function (v) {
            var o = document.createElement('option');
            o.value = v;
            o.textContent = v;
            sel.appendChild(o);
        });
        sel.disabled = false;
    }

    function renderTable() {
        var tab = TABS[activeTab];
        if (!tab) { return; }

        var visibleData = getVisibleData();
        if (!visibleData.length) {
            document.getElementById('hc-empty').textContent = 'No hourly data found for the selected filters.';
            document.getElementById('hc-count').textContent = '0 rows';
            setState('empty');
            return;
        }

        var hHtml = '<tr><th style="width:28px;color:#9ca3af;">#</th>';
        tab.heads.forEach(function (h) { hHtml += '<th>' + h + '</th>'; });
        hHtml += '</tr>';
        document.getElementById('hc-thead').innerHTML = hHtml;

        // Group rows by Country|Operator|Service for cumulative rows
        var groupKeys = [];
        var groupMap  = {};
        visibleData.forEach(function (r) {
            var k = (r.Country || '') + '|||' + (r.Operator || '') + '|||' + (r.Service || '');
            if (!groupMap[k]) { groupMap[k] = []; groupKeys.push(k); }
            groupMap[k].push(r);
        });

        var searchRaw = (document.getElementById('hc-search').value || '').toLowerCase();
        var searchTerms = searchRaw.split(',').map(function (t) { return t.trim(); }).filter(function (t) { return t.length > 0; });
        if (searchTerms.length) {
            groupKeys = groupKeys.filter(function (key) {
                var parts = key.split('|||');
                var dims = parts.join(' ').toLowerCase();
                return searchTerms.every(function (term) { return dims.indexOf(term) >= 0; });
            });
        }
        var totalGroups = groupKeys.length;

        var grand = { TodayRev:0, YestRev:0, Avg7Rev:0, TodayRenewal:0, YestRenewal:0, Avg7Renewal:0, TodayActiv:0, YestActiv:0, Avg7Activ:0, TodayChurn:0, YestChurn:0, Avg7Churn:0, TodayGood:0, YestGood:0, Avg7Good:0, TodayBad:0, YestBad:0, Avg7Bad:0 };

        var html         = '';
        var idx          = 0;
        var groupCounter = 0;

        groupKeys.forEach(function (key) {
            var gRows = groupMap[key];
            var base  = gRows[0];
            groupCounter++;
            var groupId = 'hcg-' + groupCounter;

            // Build cumulative totals for this Country/Operator/Service
            var cumul = {
                Country: base.Country, Operator: base.Operator, Service: base.Service,
                Hour: -1,
                TodayRev: 0,     YestRev: 0,     Avg7Rev: 0,
                TodayRenewal: 0, YestRenewal: 0, Avg7Renewal: 0,
                TodayActiv: 0,   YestActiv: 0,   Avg7Activ: 0,
                TodayChurn: 0,   YestChurn: 0,   Avg7Churn: 0,
                TodayGood: 0,    YestGood: 0,    Avg7Good: 0,
                TodayBad: 0,     YestBad: 0,     Avg7Bad: 0
            };
            gRows.forEach(function (r) {
                cumul.TodayRev     += Number(r.TodayRev)     || 0;
                cumul.YestRev      += Number(r.YestRev)      || 0;
                cumul.Avg7Rev      += Number(r.Avg7Rev)      || 0;
                cumul.TodayRenewal += Number(r.TodayRenewal) || 0;
                cumul.YestRenewal  += Number(r.YestRenewal)  || 0;
                cumul.Avg7Renewal  += Number(r.Avg7Renewal)  || 0;
                cumul.TodayActiv   += Number(r.TodayActiv)   || 0;
                cumul.YestActiv    += Number(r.YestActiv)    || 0;
                cumul.Avg7Activ    += Number(r.Avg7Activ)    || 0;
                cumul.TodayChurn   += Number(r.TodayChurn)   || 0;
                cumul.YestChurn    += Number(r.YestChurn)    || 0;
                cumul.Avg7Churn    += Number(r.Avg7Churn)    || 0;
                cumul.TodayGood    += Number(r.TodayGood)    || 0;
                cumul.YestGood     += Number(r.YestGood)     || 0;
                cumul.Avg7Good     += Number(r.Avg7Good)     || 0;
                cumul.TodayBad     += Number(r.TodayBad)     || 0;
                cumul.YestBad      += Number(r.YestBad)      || 0;
                cumul.Avg7Bad      += Number(r.Avg7Bad)      || 0;
            });

            grand.TodayRev     += cumul.TodayRev;     grand.YestRev     += cumul.YestRev;     grand.Avg7Rev     += cumul.Avg7Rev;
            grand.TodayRenewal += cumul.TodayRenewal; grand.YestRenewal += cumul.YestRenewal; grand.Avg7Renewal += cumul.Avg7Renewal;
            grand.TodayActiv   += cumul.TodayActiv;   grand.YestActiv   += cumul.YestActiv;   grand.Avg7Activ   += cumul.Avg7Activ;
            grand.TodayChurn   += cumul.TodayChurn;   grand.YestChurn   += cumul.YestChurn;   grand.Avg7Churn   += cumul.Avg7Churn;
            grand.TodayGood    += cumul.TodayGood;    grand.YestGood    += cumul.YestGood;    grand.Avg7Good    += cumul.Avg7Good;
            grand.TodayBad     += cumul.TodayBad;     grand.YestBad     += cumul.YestBad;     grand.Avg7Bad     += cumul.Avg7Bad;

            // Toggle arrow button injected next to cumulative label
            var toggleBtn = ' <button class="hc-toggle" data-group="' + groupId + '" title="Show / hide hourly breakdown">&#9660;</button>';

            var latestHour = getGroupLatestHour(gRows);
            var cumulLabel = latestHour >= 0 ? 'Till ' + hourLabel(latestHour) : 'TOTAL';

            // Render cumulative TOTAL row (highlighted blue) with toggle arrow
            var cCells = tab.cells(cumul);
            if (Array.isArray(cCells)) {
                // Retry tab: two cumul rows — arrow only on the first
                cCells[0] = cCells[0].replace('>TOTAL<', '>' + cumulLabel + toggleBtn + '<');
                cCells.forEach(function (c) {
                    idx++;
                    html += '<tr class="hc-cumul-row"><td style="color:#6b7280;font-size:11px;">' + idx + '</td>' + c + '</tr>';
                });
            } else {
                cCells = cCells.replace('>TOTAL<', '>' + cumulLabel + toggleBtn + '<');
                idx++;
                html += '<tr class="hc-cumul-row"><td style="color:#6b7280;font-size:11px;">' + idx + '</td>' + cCells + '</tr>';
            }

            // Individual hour rows — hidden by default, revealed on arrow click
            gRows.forEach(function (r) {
                var cells = tab.cells(r);
                if (Array.isArray(cells)) {
                    cells.forEach(function (c) {
                        idx++;
                        html += '<tr data-group="' + groupId + '" style="display:none;"><td style="color:#9ca3af;font-size:11px;">' + idx + '</td>' + c + '</tr>';
                    });
                } else {
                    idx++;
                    html += '<tr data-group="' + groupId + '" style="display:none;"><td style="color:#9ca3af;font-size:11px;">' + idx + '</td>' + cells + '</tr>';
                }
            });
        });

        document.getElementById('hc-tbody').innerHTML = html;
        var rangeLabel = ' | Cumulative to each country latest hour';
        var countLabel = searchTerms.length
            ? totalGroups + ' of ' + Object.keys(groupMap).length + ' groups match'
            : idx + ' row' + (idx !== 1 ? 's' : '');
        document.getElementById('hc-count').textContent = countLabel + rangeLabel;
        setState('data');
    }

    // Expand / collapse hourly rows when ▼ / ▲ is clicked on a TOTAL row
    document.getElementById('hc-wrap').addEventListener('click', function (e) {
        var btn = e.target;
        while (btn && btn !== this) {
            if (btn.className && btn.className.indexOf('hc-toggle') >= 0) { break; }
            btn = btn.parentNode;
        }
        if (!btn || !btn.className || btn.className.indexOf('hc-toggle') < 0) { return; }

        var groupId = btn.getAttribute('data-group');
        var rows    = document.querySelectorAll('tr[data-group="' + groupId + '"]');
        var expand  = rows.length > 0 && rows[0].style.display === 'none';
        for (var i = 0; i < rows.length; i++) {
            rows[i].style.display = expand ? '' : 'none';
        }
        btn.innerHTML = expand ? '&#9650;' : '&#9660;'; // ▲ collapse  ▼ expand
    });

    function getVisibleData() {
        if (!allData.length) {
            return [];
        }

        return allData.filter(function (row) {
            var latestHour = Number(row.LatestHour);
            return isNaN(latestHour) || latestHour < 0 || Number(row.Hour) <= latestHour;
        });
    }

    function getGroupLatestHour(rows) {
        var latest = -1;
        (rows || []).forEach(function (row) {
            var h = Number(row.LatestHour);
            if (!isNaN(h) && h > latest) {
                latest = h;
            }
        });
        return latest;
    }

    function setState(state, msg) {
        document.getElementById('hc-loading').style.display = state === 'loading' ? 'block' : 'none';
        document.getElementById('hc-error').style.display = state === 'error' ? 'block' : 'none';
        document.getElementById('hc-prompt').style.display = state === 'prompt' ? 'block' : 'none';
        document.getElementById('hc-empty').style.display = state === 'empty' ? 'block' : 'none';
        document.getElementById('hc-wrap').style.display = state === 'data' ? 'block' : 'none';
        document.getElementById('hc-foot').style.display = state === 'data' ? 'flex' : 'none';
        if (state === 'error' && msg) {
            document.getElementById('hc-error').textContent = msg;
        }
    }

    function statusInfo(today, yest, inverted) {
        today = Number(today) || 0;
        yest = Number(yest) || 0;

        if (yest === 0 && today === 0) {
            return { status: 'neut', remark: '-' };
        }
        if (yest === 0) {
            return { status: 'neut', remark: 'No yesterday data' };
        }
        if (today === 0) {
            return { status: 'crit', remark: 'No today data' };
        }

        var pct = (today - yest) / Math.abs(yest) * 100;
        var absPct = Math.abs(pct).toFixed(1);
        var dir = pct >= 0 ? '+' : '-';

        var status;
        if (inverted) {
            if (pct > 20) {
                status = 'crit';
            } else if (pct > 5) {
                status = 'warn';
            } else {
                status = 'ok';
            }
        } else {
            if (pct < -20) {
                status = 'crit';
            } else if (pct < -5) {
                status = 'warn';
            } else {
                status = 'ok';
            }
        }

        if (Math.abs(pct) < 1) {
            return { status: status, remark: 'Same as yesterday' };
        }

        return { status: status, remark: dir + absPct + '% vs yesterday' };
    }

    function badge(status) {
        var cfg = {
            ok: { cls: 'hc-ok', label: 'OK' },
            warn: { cls: 'hc-warn', label: 'WARN' },
            crit: { cls: 'hc-crit', label: 'LOW' },
            neut: { cls: 'hc-neut', label: 'N/A' }
        }[status] || { cls: 'hc-neut', label: 'N/A' };

        return '<span class="hc-badge ' + cfg.cls + '">' + cfg.label + '</span>';
    }

    function hourLabel(hour) {
        var h = Number(hour);
        if (isNaN(h)) { return '-'; }
        if (h < 0)    { return 'TOTAL'; }
        var hh = h < 10 ? '0' + h : String(h);
        return hh + ':00';
    }

    function fmt(n) {
        return Math.round(Number(n) || 0).toLocaleString();
    }

    function esc(s) {
        return (s == null ? '-' : String(s))
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function td(inner) { return '<td>' + inner + '</td>'; }
    function tdR(inner) { return '<td style="text-align:right;">' + inner + '</td>'; }
    function tdC(inner) { return '<td style="text-align:center;">' + inner + '</td>'; }

    var defaultRegionChip = document.querySelector('#hc-region-chips .region-chip.active')
        || document.querySelector('#hc-region-chips .region-chip');

    if (defaultRegionChip) {
        defaultRegionChip.click();
    } else {
        setState('prompt');
    }
})();
</script>
