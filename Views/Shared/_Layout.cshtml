@{
    var siteCssVersion = System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/site.css")).Ticks.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css?v=" + siteCssVersion)" />
</head>
<body>
    <div class="layout-shell">
        @if (Session["UserId"] != null)
        {
            <header class="topbar">
                <div class="topbar-brand-wrap">
                    <img src="@Url.Content("~/Content/images/nazara-logo.png")" alt="Nazara" class="topbar-logo" />
                    <div>
                        <div class="topbar-brand">VAS Reporting Tool</div>
                        <div class="topbar-sub">Secure region-wise reporting</div>
                    </div>
                </div>
                <div class="btn-row">
                    <a class="ghost-btn" href="@Url.Action("Index", "Dashboard")">Reports</a>
                    <a class="ghost-btn" href="@Url.Action("Index", "Activation")">ACT</a>
                    <a class="ghost-btn" href="@Url.Action("Index", "ToolSummary")">MissingRPT</a>
                    <a class="ghost-btn" href="@Url.Action("Hourly", "ToolSummary")">Hourly</a>
                    <a class="ghost-btn" href="@Url.Action("ArpuData", "ToolSummary")">ARPU</a>
                    @if (Convert.ToString(Session["Role"]) == "Admin")
                    {
                        <a class="ghost-btn" href="@Url.Action("Index", "Admin")">Admin</a>
                    }
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="primary-btn">Logout</button>
                    }
                </div>
            </header>
        }
        @RenderBody()
    </div>

    @if (Session["UserId"] != null)
    {
        <script>
            (function () {
                var keepAliveUrl = '@Url.Action("KeepAlive", "Account")';
                var authExpiresOnUtc = '@Convert.ToString(Session["AuthExpiresOnUtc"])';

                function ping() {
                    if (!authExpiresOnUtc) {
                        return;
                    }

                    var expiresAt = Date.parse(authExpiresOnUtc);
                    if (!isNaN(expiresAt) && Date.now() >= expiresAt) {
                        window.location = '@Url.Action("Login", "Account")';
                        return;
                    }

                    var xhr = new XMLHttpRequest();
                    xhr.open('GET', keepAliveUrl, true);
                    xhr.send();
                }

                setInterval(ping, 20 * 60 * 1000);
            })();
        </script>
    }
</body>
</html>
